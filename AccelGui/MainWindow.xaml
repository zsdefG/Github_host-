<Window x:Class="AccelGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accel Server 图形控制台" Height="620" Width="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel>
                <WrapPanel x:Name="ConfigPanel">
                    <TextBlock Text="模式" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ModeBox" Width="90" SelectionChanged="OnModeChanged">
                        <ComboBoxItem Content="DNS 加速"/>
                        <ComboBoxItem Content="Proxy 加速"/>
                    </ComboBox>
                    <TextBlock Text="端口" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <TextBox x:Name="PortBox" Width="70" Text="5353" VerticalContentAlignment="Center"/>
                    <TextBlock Text="上游DNS" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <TextBox x:Name="UpstreamBox" Width="110" Text="223.5.5.5" VerticalContentAlignment="Center"/>
                    <TextBlock Text="复检(秒)" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <TextBox x:Name="RecheckBox" Width="50" Text="60" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="AutoProxyBox" Content="自动设置系统代理" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </WrapPanel>
                <!-- 启停/设置/连接测试按钮独立于 ConfigPanel：精简模式下仅折叠配置项，按钮常显 -->
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="StartBtn" Content="启动" Width="90" Height="26" Click="OnStartStop"/>
                    <Button x:Name="SettingsBtn" Content="设置" Width="60" Height="26" Margin="6,0,0,0" Click="OnSettings"/>
                    <Button x:Name="ConnectTestBtn" Content="连接测试" Width="80" Height="26" Margin="6,0,0,0" Click="OnConnectTest"/>
                </WrapPanel>
                <TextBlock x:Name="HintText" Text="提示：Proxy 模式不做 HTTPS 中间人/不装证书；停止时自动还原系统代理。"
                           FontSize="11" Foreground="#888888" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- 底部状态栏 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#999999" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="未启动" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ModeLabel" Text="显示模式：标准" FontSize="11" Foreground="#888888"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 主体：IP 表 + 日志 -->
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock x:Name="IpHeader" DockPanel.Dock="Left" Text="当前优选 IP 表（每 5 秒刷新）" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Content="立即刷新" Width="80" Height="24" Click="OnRefresh"/>
            </DockPanel>
            <DataGrid x:Name="IpGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,0,0,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="加速域名" Binding="{Binding Domain}" Width="*"/>
                    <DataGridTextColumn Header="优选 IP（按健康检测排序）" Binding="{Binding IpText}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>
            <GroupBox Grid.Row="2" Header="日志">
                <RichTextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" Background="White"/>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>